---
layout: base.njk
---
<section class="profile" aria-label="About me">
  <div class="profile-portrait">
    {% if photo %}
      <img class="profile-photo" src="{{ photo | escape }}" alt="{{ photo_alt | escape }}" width="144" height="144">
    {% else %}
      <div class="profile-placeholder" role="img" aria-label="Profile photo placeholder">
        <span aria-hidden="true">{{ initials | escape }}</span>
      </div>
    {% endif %}
  </div>
  <div class="profile-copy">
    {{ content | safe }}
    {% if socials | length %}
      <ul class="social-links" aria-label="Social links">
        {% for social in socials %}
          <li>
            {% if social.url %}
              <a class="social-icon social-icon--{{ social.label | lower }}" href="{{ social.url | escape }}" aria-label="{{ social.label | escape }}" title="{{ social.label | escape }}">
            {% else %}
              <span class="social-icon social-icon--{{ social.label | lower }} social-pending" role="img" aria-label="{{ social.label | escape }} link coming soon" title="{{ social.label | escape }} link coming soon">
            {% endif %}
              {% if social.label == "LinkedIn" %}
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z"/></svg>
              {% elif social.label == "Strava" %}
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m15.387 17.944-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066M10.463 8.229l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/></svg>
              {% endif %}
            {% if social.url %}</a>{% else %}</span>{% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
    <p class="journal-link"><a href="/journal/">Read the journal →</a></p>
  </div>
</section>
