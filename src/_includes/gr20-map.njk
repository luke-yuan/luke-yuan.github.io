<section class="route-explorer" id="gr20-route" aria-labelledby="route-heading">
  <h2 id="route-heading">Overview</h2>
  <div class="route-card">
    <div class="route-summary" aria-live="polite" aria-atomic="true">
      <div>
        <p class="route-kicker" id="route-selection">All seven days · South → North</p>
        <h3 id="route-title">Conca → Calenzana</h3>
      </div>
      <dl class="route-metrics">
        <div><dt>Distance</dt><dd><span id="route-distance">{{ gr20.totals.distanceLabel }}</span> <small>km</small></dd></div>
        <div><dt>Est. elevation gain</dt><dd>+<span id="route-gain">{{ gr20.totals.gainLabel }}</span> <small>m</small></dd></div>
      </dl>
    </div>
    <div class="route-map-shell">
      <svg class="route-outline" viewBox="0 0 640 360" role="img" aria-labelledby="route-outline-title">
        <title id="route-outline-title">Outline of the seven GPX routes, from Conca in the south to Calenzana in the north</title>
        <text x="32" y="40" class="route-outline-note">N ↑</text>
        {%- for day in gr20.days -%}
        <path d="{{ day.overviewPath }}" fill="none" stroke="{{ day.color }}" stroke-width="3" stroke-linejoin="round" />
        {%- endfor -%}
        <circle cx="{{ gr20.overview.start[0] }}" cy="{{ gr20.overview.start[1] }}" r="5" fill="#292d29" />
        <text x="{{ gr20.overview.start[0] + 12 }}" y="{{ gr20.overview.start[1] + 5 }}">Conca</text>
        <circle cx="{{ gr20.overview.end[0] }}" cy="{{ gr20.overview.end[1] }}" r="5" fill="#292d29" />
        <text x="{{ gr20.overview.end[0] + 12 }}" y="{{ gr20.overview.end[1] + 5 }}">Calenzana</text>
        <text x="32" y="338" class="route-outline-note">GPX route outline · not a navigation map</text>
      </svg>
      <div id="route-map" class="route-map" role="region" aria-label="Interactive GR20 route map" hidden></div>
    </div>
    <p class="route-map-status" id="route-map-status" role="status" hidden>Loading the interactive map…</p>
    <noscript><p class="route-map-status">Enable JavaScript for the interactive map and elevation profiles. The route outline and daily estimates are shown here without it.</p></noscript>
    <div class="route-profile" id="route-profile" hidden>
      <div class="route-profile-heading">
        <span>Elevation profile <small>(m)</small></span>
        <span class="profile-readout" id="profile-readout">Move over the profile to explore</span>
      </div>
      <svg class="elevation-profile" id="elevation-profile" viewBox="0 0 640 170" role="img" aria-label="Seven-day elevation profile"></svg>
    </div>
    <div class="route-days" role="group" aria-label="Choose a hiking day">
      <button type="button" class="route-day route-day--all" data-day="0" aria-pressed="true" disabled>
        <span class="route-day-name">Full route</span>
        <span class="route-day-stops">All seven days</span>
        <span class="route-day-stats">{{ gr20.totals.distanceLabel }} km <span>+{{ gr20.totals.gainLabel }} m</span></span>
      </button>
      {%- for day in gr20.days -%}
      <button type="button" class="route-day" data-day="{{ day.day }}" style="--day-color: {{ day.color }}" aria-pressed="false" disabled>
        <span class="route-day-name"><span class="route-dot" aria-hidden="true"></span>Day {{ day.day }}</span>
        <span class="route-day-stops">{{ day.from }} → {{ day.to }}</span>
        <span class="route-day-stats">{{ day.distanceLabel }} km <span>+{{ day.gainLabel }} m</span></span>
      </button>
      {%- endfor -%}
    </div>
    <div class="route-footnote">
      <a id="route-download" href="/assets/gr20/gr20-seven-day-routes.zip" download>Download all seven GPX routes</a>
      <details>
        <summary>About these estimates</summary>
        <p>Routes and distances come from the GPX files linked below. Elevations come from <a href="https://geoservices.ign.fr/rgealti">IGN’s RGE ALTI terrain data</a>, retrieved on {{ gr20.source.retrievedDate }} through its <a href="{{ gr20.source.documentationUrl }}">elevation service</a> at each original GPX track point. The profile uses those terrain elevations, not the elevations embedded in the GPX.</p>
        <p>Distance sums horizontal distances between track points. Elevation gain (D+) adds uphill terrain-elevation changes without smoothing and is rounded to the nearest 10 m. Gaps between separate track segments are excluded. These are our calculations from official terrain data, not official published stage totals or recorded Garmin/Strava activities. Track spacing and terrain-model errors can undercount or overcount climbs, so these figures may differ from your watch or the journal. This map is for the trip story, not navigation.</p>
      </details>
      <p class="route-estimate-label">Distance: GPX · Elevation: <a href="https://geoservices.ign.fr/rgealti">© IGN · RGE ALTI</a> · Estimated meters climbed (D+)</p>
    </div>
  </div>
</section>
